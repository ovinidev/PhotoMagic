{
  "name": "fotomagica",
  "productName": "Foto Mágica",
  "version": "0.2.0",
  "private": true,
  "description": "Foto Mágica 2.0 — party photobooth for a vertical touch TV and the DNP DS-RX1",
  "author": "Vinicius (@ovinidev)",
  "license": "UNLICENSED",
  "homepage": "https://github.com/ovinidev/PhotoMagic",
  "repository": {
    "type": "git",
    "url": "https://github.com/ovinidev/PhotoMagic.git"
  },
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint --deny-warnings .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win",
    "icon": "node scripts/build-icon.mjs",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@tailwindcss/oxide"
    ],
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
